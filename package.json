{
  "name": "modern-accounting-ce",
  "version": "1.3.1",
  "description": "Modern Accounting Community Edition",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "db:deploy": "node scripts/deploy-db.js",
    "start:docker": "docker compose -f docker-compose.ce.yml up",
    "start:app": "docker compose -f docker-compose.ce.yml --env-file .env.ce --profile app up --build",
    "quickstart": "./scripts/quickstart.sh",
    "sample-data": "node scripts/sample-data/run.mjs",
    "test:sample-data": "node --test scripts/sample-data/*.test.mjs"
  },
  "dependencies": {
    "mssql": "^12.2.0"
  }
}
