{
  "name": "chat-api",
  "version": "1.0.0",
  "description": "Chat API for accounting assistant",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --import ./src/ce/preload.js --max-old-space-size=2048 server.js",
    "dev": "node --import ./src/ce/preload.js --max-old-space-size=2048 server.js",
    "test": "vitest run",
