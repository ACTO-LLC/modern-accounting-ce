    "@azure/openai": "^1.0.0-beta.12",
    "@types/multer": "^2.0.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "http-proxy-middleware": "^3.0.5",
    "jose": "^5.2.0",
    "mssql": "^10.0.4",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "openai": "^4.28.0",
    "puppeteer": "^24.37.5",
    "scribe.js-ocr": "^0.9.3"
  },
  "devDependencies": {
    "supertest": "^6.0.0",
    "vitest": "^1.6.1"
  }
