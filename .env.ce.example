# Modern Accounting CE — env sample (no secrets; no paid integrations)
# Copy to `.env.ce` locally (never commit `.env` / `.env.ce`).

# --- SQL / Compose ---
SQL_SA_PASSWORD=ChangeMe_CE_Dev_Password1
SQL_CONNECTION_STRING=Server=localhost,14330;Database=AccountingDB;User Id=sa;Password=ChangeMe_CE_Dev_Password1;TrustServerCertificate=True

# --- Auth (CE = local / simple only) ---
BYPASS_AUTH=true
CE_BUILD=true
VITE_BYPASS_AUTH=true
VITE_CE_BUILD=true
# Do NOT configure enterprise SSO or MFA packaging in CE.

# --- App URLs (browser uses localhost published ports) ---
APP_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080
VITE_EMAIL_API_URL=http://localhost:7073
VITE_DAB_URL=http://localhost:5000

# --- Milton / categorization BYO LLM (optional) ---
# OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=

# --- Basic SMTP invoice email (optional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
EMAIL_ENCRYPTION_KEY=change-me-ce-dev-only

# =============================================================================
# BLOCKLIST — do NOT set in CE (paid / private). Presence should fail assert /
# CE_BUILD assertPaidNotLinked at chat-api boot.
# =============================================================================
# STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_MODE
# PLAID_* (prod bank-link packaging)
# Live QBO OAuth prod credentials (live sync — paid)
# GITHUB_TOKEN for write-agent / open-PR
# Practice-OS / ClaimId join secrets
# ACTO managed cloud / control-plane credentials
