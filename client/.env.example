# Modern Accounting CE — client env sample (no secrets; local/bypass auth only)
# Prefer root `.env.ce` for Compose. Copy values here only for non-Compose Vite runs.

# --- Auth (CE = local / bypass only) ---
VITE_BYPASS_AUTH=true
VITE_CE_BUILD=true

# --- API URLs (browser reaches published host ports) ---
VITE_API_URL=http://localhost:8080
VITE_CHAT_API_URL=http://localhost:8080
VITE_EMAIL_API_URL=http://localhost:7073
VITE_DAB_URL=http://localhost:5000
VITE_PORT=5173

# Do NOT configure enterprise SSO packaging, prod bank-link, or paid payment keys in CE.
